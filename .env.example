FV_ENVIRONMENT=development
FV_DATABASE_URL=sqlite:///./data/fire_viewer.db
# Neon/Vercel example:
# FV_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
FV_DATABASE_POOL_SIZE=2
FV_DATABASE_MAX_OVERFLOW=3
FV_DATABASE_POOL_RECYCLE_SECONDS=300
FV_DATABASE_STATEMENT_TIMEOUT_MS=15000
FV_DATABASE_SCHEMA_REVISION=b7f2e4a9c810

# Le projet Vercel API suit une file RunPod globale et strictement séquentielle.
# Contributions utilisateur: toutes les 3 h. Recherche médiatique: 11 h/23 h
# Europe/Paris. Satellite/points chauds/thermique: run média de 11 h.
# Une action humaine peut déclencher immédiatement le prochain pas autorisé.
# Vercel envoie CRON_SECRET comme jeton Bearer sur la route interne.
FV_AGENT_DISPATCH_ENABLED=false
CRON_SECRET=
FV_AGENT_MEDIA_ALLOWED_HOSTS=["private-media.example"]
# Objet JSON role -> révision immuable attendue, incluant le SHA-256 RT-DETR privé.
FV_AGENT_EXPECTED_MODEL_REVISIONS={}
FV_AGENT_RUNPOD_TRANSPORT=pod
# URL HTTPS du proxy RunPod du pod de recette, par exemple https://<pod>-8000.proxy.runpod.net
FV_AGENT_RUNPOD_POD_BASE_URL=
FV_AGENT_RUNPOD_POD_AUTH_TOKEN=
# Utilisés seulement après bascule explicite vers FV_AGENT_RUNPOD_TRANSPORT=serverless.
FV_AGENT_RUNPOD_ENDPOINT_ID=
FV_AGENT_RUNPOD_API_KEY=
FV_AGENT_EXECUTION_TIMEOUT_MS=900000
FV_AGENT_JOB_TTL_MS=3600000
FV_AGENT_POLL_INTERVAL_SECONDS=5
FV_AGENT_DISPATCH_LEASE_SECONDS=90
FV_AGENT_DISPATCH_MAX_ATTEMPTS=3
FV_OBJECT_STORAGE_BACKEND=local
FV_OBJECT_STORAGE_PREFIX=firewarning
# Connected automatically by a private Vercel Blob store. Keep it server-side only.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
FV_LOG_LEVEL=INFO
FV_AUTH_MODE=disabled
# Event documentation v2 is additive and fail-closed behind these flags.
FV_EVENT_V2_ENABLED=false
FV_SUPABASE_AUTH_ENABLED=false
FV_OFFICIAL_CONNECTORS_ENABLED=false
# Exact provider/collection routes only. This JSON must never contain credentials.
# FV_OFFICIAL_CONNECTOR_COLLECTIONS={"copernicus-data-space/sentinel-3-sl-2-frp-nrt":{"enabled":true,"kind":"cdse_stac"}}
# Server-side credential required only when a meteo_france_synop route is enabled.
# FV_METEO_FRANCE_ACCESS_TOKEN=
FV_AGENT_EVENT_PIPELINE_ENABLED=false
FV_3D_PRIMARY_ENABLED=false
FV_V2_PUBLICATION_ENABLED=false
# Required for media finalization outside tests. `test_clean` is rejected unless
# FV_ENVIRONMENT=test.
FV_EVENT_ANTIVIRUS_MODE=disabled
# FV_EVENT_CLAMAV_HOST=127.0.0.1
# FV_EVENT_CLAMAV_PORT=3310
# HTTPS backend origin reachable by the private GPU worker. The signing secret
# stays server-side and must contain at least 32 random characters outside tests.
# FV_AGENT_MEDIA_PROXY_BASE_URL=https://api.fireviewer.example
# FV_AGENT_MEDIA_SIGNING_SECRET=
# FV_EVENT_WORKER_EVIDENCE_URL_TTL_SECONDS=1800
# Compte administrateur unique (développement et production initiale) :
# FV_AUTH_MODE=local_admin
# FV_LOCAL_ADMIN_USERNAME=admin
# FV_LOCAL_ADMIN_PASSWORD_HASH=scrypt$...
# FV_PUBLIC_REPORT_HASH_SECRET=au-moins-32-caracteres-aleatoires # gitleaks:allow
FV_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FV_TRUSTED_HOSTS=["localhost","127.0.0.1"]
FV_MAX_BODY_BYTES=1048576

# Required when FV_AUTH_MODE=jwt
# FV_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
# FV_OIDC_ISSUER=https://identity.example/
# FV_OIDC_AUDIENCE=fire-viewer-api
# FV_OIDC_ROLES_CLAIM=roles

# Required when FV_AUTH_MODE=supabase. Use the project URL and publishable key;
# never configure a service_role key in this application.
# FV_SUPABASE_URL=https://project-ref.supabase.co
# FV_SUPABASE_PUBLISHABLE_KEY=
# FV_SUPABASE_SESSION_VALIDATION_ENABLED=true
